# LLM Provider
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.7-max
LLM_BASE_URL=
LLM_API_KEY=

# Console v0.2.1 Planning (explicitly select: ollama or openai-compatible)
S5_PLANNING_PROVIDER=
S5_PLANNING_BASE_URL=
S5_PLANNING_API_KEY=
S5_PLANNING_MODEL=
# Optional server-side timeout in seconds: default 30, maximum 60 (Demo: 45).
S5_PLANNING_TIMEOUT_SECONDS=

# Console v0.2.1 Embedding (selected independently)
S5_EMBEDDING_PROVIDER=
S5_EMBEDDING_BASE_URL=
S5_EMBEDDING_API_KEY=
S5_EMBEDDING_MODEL=

# Console local-development Ollama compatibility; used only when the relevant
# provider above is explicitly set to ollama.
S5_IMPL_041_OLLAMA_URL=http://127.0.0.1:11434
S5_IMPL_041_PLANNING_MODEL=qwen3:8B
S5_IMPL_041_EMBEDDING_MODEL=shaw/dmeta-embedding-zh:latest
S5_IMPL_041_QDRANT_URL=http://127.0.0.1:6333

# Qwen options
LLM_ENABLE_THINKING=true

# Runtime
LOG_LEVEL=INFO
AGENT_NAMESPACE=agent-workloads
AGENT_SYSTEM_NAMESPACE=agent-system

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Database
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent_platform

# Redis
REDIS_URL=redis://redis:6379/0
# Agent Definition product-continuity persistence (values are local examples only).
AGENT_DEFINITION_DATABASE_URL=postgresql://agent_console@127.0.0.1:5432/agent_platform
AGENT_DEFINITION_DB_POOL_MIN=1
AGENT_DEFINITION_DB_POOL_MAX=4
AGENT_DEFINITION_DB_TIMEOUT_SECONDS=5
