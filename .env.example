# LLM Provider
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.7-max
LLM_BASE_URL=
LLM_API_KEY=

# Qwen options
LLM_ENABLE_THINKING=true

# Runtime
LOG_LEVEL=INFO
AGENT_NAMESPACE=agent-workloads
AGENT_SYSTEM_NAMESPACE=agent-system

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Database
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent_platform

# Redis
REDIS_URL=redis://redis:6379/0
